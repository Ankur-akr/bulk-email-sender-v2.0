# ── PostgreSQL (any hosted Postgres: Neon, Supabase, Aiven, Railway, RDS…) ────
# Paste the provider's connection string as-is. postgres:// and postgresql://
# prefixes and ?sslmode=require are all handled automatically.
#   Neon:     postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
#   Local:    postgresql://postgres:postgres@localhost:5432/emailsender
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional tuning (defaults are fine): DB_POOL_SIZE=5  DB_POOL_RECYCLE=300  DB_CONNECT_TIMEOUT=30

# ── AWS SES ───────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-1
SENDER_EMAIL=you@yourdomain.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ── JWT (generate: openssl rand -hex 32) ─────────────────────────────────────
JWT_SECRET_KEY=replace_with_random_64_char_string
JWT_EXPIRE_HOURS=24

# ── Admin fallback login (leave ADMIN_PASSWORD empty to disable it) ───────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!

# ── Optional: restrict Google login to specific email domains ─────────────────
# ALLOWED_DOMAINS=yourcompany.com,partner.com

# ── CORS: your Vercel frontend URL ────────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app
