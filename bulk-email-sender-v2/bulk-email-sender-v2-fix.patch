+
+/* Status/alert surfaces retain their semantic hue but gain dark contrast. */
+[data-theme="dark"] [class~="bg-blue-50"] { background-color: rgba(30, 64, 175, .22) !important; }
+[data-theme="dark"] [class~="bg-green-50"] { background-color: rgba(22, 101, 52, .22) !important; }
+[data-theme="dark"] [class~="bg-red-50"] { background-color: rgba(153, 27, 27, .22) !important; }
+[data-theme="dark"] [class~="bg-orange-50"] { background-color: rgba(154, 52, 18, .22) !important; }
+[data-theme="dark"] [class~="bg-amber-50"] { background-color: rgba(120, 53, 15, .24) !important; }
+[data-theme="dark"] [class~="bg-amber-100"] { background-color: rgba(146, 64, 14, .28) !important; }
+[data-theme="dark"] [class~="border-blue-100"] { border-color: rgba(96, 165, 250, .30) !important; }
+[data-theme="dark"] [class~="border-blue-200"] { border-color: rgba(96, 165, 250, .35) !important; }
+[data-theme="dark"] [class~="border-green-100"] { border-color: rgba(74, 222, 128, .25) !important; }
+[data-theme="dark"] [class~="border-red-200"] { border-color: rgba(248, 113, 113, .30) !important; }
+[data-theme="dark"] [class~="border-amber-200"],
+[data-theme="dark"] [class~="border-amber-300"] { border-color: rgba(251, 191, 36, .35) !important; }
+
+/* Better contrast for the neutral text used inside semantic cards. */
+[data-theme="dark"] [class~="text-blue-800"],
+[data-theme="dark"] [class~="text-blue-700"] { color: #93c5fd !important; }
+[data-theme="dark"] [class~="text-green-800"],
+[data-theme="dark"] [class~="text-green-700"],
+[data-theme="dark"] [class~="text-green-600"] { color: #86efac !important; }
+[data-theme="dark"] [class~="text-red-600"],
+[data-theme="dark"] [class~="text-red-500"] { color: #fca5a5 !important; }
+[data-theme="dark"] [class~="text-orange-800"],
+[data-theme="dark"] [class~="text-orange-700"],
+[data-theme="dark"] [class~="text-orange-600"],
+[data-theme="dark"] [class~="text-orange-500"] { color: #fdba74 !important; }
+[data-theme="dark"] [class~="text-amber-900"],
+[data-theme="dark"] [class~="text-amber-800"],
+[data-theme="dark"] [class~="text-amber-700"],
+[data-theme="dark"] [class~="text-amber-600"] { color: #fcd34d !important; }
+
+/* Toastify follows the selected theme. */
+[data-theme="dark"] .Toastify__toast {
+  background: #0f172a;
+  color: #e2e8f0;
+  border: 1px solid #334155;
+}
+[data-theme="dark"] .Toastify__close-button { color: #94a3b8; }
+
+/* Scrollbars */
+[data-theme="dark"] ::-webkit-scrollbar-track { background: #020617; }
+[data-theme="dark"] ::-webkit-scrollbar-thumb { background: #334155; }
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    scroll-behavior: auto !important;
+    transition-duration: .01ms !important;
+    animation-duration: .01ms !important;
+  }
+}
